/* Reset and Base Styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Times New Roman', 'Georgia', serif;
    background-color: #ffffff;
    color: #333333;
    line-height: 1.6;
    direction: rtl;
}

.page-wrapper {
    max-width: 1280px;
    margin: 0 auto;
    background: #ffffff;
}

/* Header Styles - The Times inspired */
.main-header {
    background: #ffffff;
    color: #333333;
    padding: 20px 40px;
    text-align: center;
    border-bottom: 4px solid #000000;
    position: relative;
}

.header-decoration {
    font-size: 18px;
    letter-spacing: 10px;
    color: #666666;
    margin: 5px 0;
}

.site-title {
    font-size: 64px;
    font-weight: 700;
    letter-spacing: -1px;
    margin: 10px 0;
    font-family: 'Times New Roman', serif;
    color: #000000;
    text-transform: none;
}

.site-subtitle {
    font-size: 14px;
    font-style: italic;
    color: #666666;
    letter-spacing: 1px;
    margin: 5px 0;
    text-transform: uppercase;
}

.date-banner {
    background: #f5f5f5;
    color: #333333;
    padding: 10px 20px;
    margin: 15px auto 0;
    border-top: 1px solid #e0e0e0;
    border-bottom: 1px solid #e0e0e0;
    font-weight: normal;
    font-size: 13px;
    max-width: 100%;
}

/* Breaking News Banner - The Times style */
.breaking-banner {
    background: #c80000;
    color: white;
    padding: 12px 40px;
    text-align: center;
    border-bottom: 1px solid #a00000;
    font-size: 14px;
}

.breaking-label {
    font-weight: 700;
    font-size: 14px;
    margin-left: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.breaking-text {
    font-size: 14px;
    font-weight: normal;
}

/* Navigation - The Times inspired */
.main-nav {
    background: #ffffff;
    border-bottom: 1px solid #e0e0e0;
    position: sticky;
    top: 0;
    z-index: 100;
}

.main-nav ul {
    list-style: none;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    max-width: 1280px;
    margin: 0 auto;
}

.main-nav li {
    flex: 0 0 auto;
}

.main-nav a {
    display: block;
    color: #333333;
    text-decoration: none;
    padding: 16px 20px;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.2s ease;
    border-bottom: 3px solid transparent;
}

.main-nav a:hover,
.main-nav a.active {
    color: #c80000;
    border-bottom-color: #c80000;
}

/* Page Title Section */
.page-title-section {
    background: #f4e4c1;
    padding: 30px 20px;
    text-align: center;
    border-bottom: 3px double #8b7355;
    margin-bottom: 20px;
}

.page-title {
    font-size: 42px;
    color: #1a1a2e;
    margin-bottom: 10px;
}

.page-subtitle {
    font-size: 18px;
    color: #5a4a3a;
    font-style: italic;
}

/* Content Grid */
.content-grid {
    padding: 30px 20px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 25px;
}

/* Featured Article */
.featured-article {
    grid-column: 1 / -1;
    background: white;
    border: 3px solid #8b7355;
    box-shadow: 5px 5px 15px rgba(0,0,0,0.2);
    position: relative;
    padding: 25px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.featured-article:hover {
    transform: translateY(-5px);
    box-shadow: 8px 8px 20px rgba(0,0,0,0.3);
}

/* Article Cards */
.article-card {
    background: white;
    border: 2px solid #8b7355;
    box-shadow: 3px 3px 10px rgba(0,0,0,0.15);
    position: relative;
    padding: 20px;
    transition: all 0.3s ease;
}

.article-card:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 5px 5px 15px rgba(0,0,0,0.25);
    border-color: #d4af37;
}

/* Article Badges */
.article-badge {
    position: absolute;
    top: 15px;
    left: 15px;
    padding: 8px 15px;
    color: white;
    font-weight: bold;
    font-size: 13px;
    border-radius: 3px;
    z-index: 10;
    box-shadow: 2px 2px 5px rgba(0,0,0,0.3);
}

.article-badge.urgent { background: #dc143c; }
.article-badge.hot { background: #ff4500; }
.article-badge.trending { background: #32cd32; }
.article-badge.shocking { background: #ff1493; }
.article-badge.exclusive { background: #4169e1; }
.article-badge.opinion { background: #9370db; }
.article-badge.breaking { background: #ff6347; }
.article-badge.viral { background: #ffa500; }
.article-badge.warning { background: #ff8c00; }
.article-badge.adventure { background: #20b2aa; }
.article-badge.tips { background: #3cb371; }
.article-badge.review { background: #bc8f8f; }
.article-badge.drama { background: #c71585; }
.article-badge.juicy { background: #ff69b4; }
.article-badge.rumor { background: #8a2be2; }
.article-badge.poll { background: #4682b4; }

/* Article Images */
.article-image {
    width: 100%;
    height: auto;
    border: 2px solid #8b7355;
    margin-bottom: 15px;
}

/* Article Typography */
article h2 {
    font-size: 32px;
    color: #1a1a2e;
    margin-bottom: 15px;
    line-height: 1.3;
}

article h3 {
    font-size: 22px;
    color: #2a2419;
    margin-bottom: 12px;
    line-height: 1.3;
}

.article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    color: #666;
    font-size: 14px;
    margin-bottom: 15px;
    padding-bottom: 15px;
    border-bottom: 1px dashed #ccc;
}

.article-excerpt {
    font-size: 16px;
    line-height: 1.8;
    color: #333;
    margin-bottom: 15px;
}

.read-more {
    display: inline-block;
    color: #8b0000;
    font-weight: bold;
    text-decoration: none;
    font-size: 18px;
    transition: all 0.3s ease;
}

.read-more:hover {
    color: #dc143c;
    transform: translateX(-5px);
}

/* Engagement Bar */
.engagement-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 15px;
    padding-top: 15px;
    border-top: 1px dashed #ccc;
    font-size: 14px;
    color: #666;
}

.engagement-bar span {
    cursor: pointer;
    transition: all 0.2s ease;
}

.engagement-bar span:hover {
    color: #8b0000;
    transform: scale(1.1);
}

/* Comments Section */
.comments-section {
    padding: 40px 20px;
    background: #f9f7f0;
    border-top: 3px double #8b7355;
    border-bottom: 3px double #8b7355;
}

.comments-section h2 {
    font-size: 32px;
    color: #1a1a2e;
    margin-bottom: 25px;
    text-align: center;
}

.comment-form {
    margin-bottom: 30px;
    background: white;
    padding: 20px;
    border: 2px solid #8b7355;
}

.comment-form textarea {
    width: 100%;
    padding: 15px;
    border: 2px solid #ccc;
    font-family: 'Georgia', serif;
    font-size: 16px;
    resize: vertical;
    background: #faf8f0;
}

.submit-comment {
    background: #3a3226;
    color: #f4e4c1;
    border: none;
    padding: 12px 30px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    margin-top: 10px;
    transition: all 0.3s ease;
}

.submit-comment:hover {
    background: #d4af37;
    color: #1a1a2e;
    transform: translateY(-2px);
}

/* Comment */
.comment {
    background: white;
    padding: 20px;
    margin-bottom: 15px;
    border: 2px solid #ddd;
    border-right: 4px solid #8b7355;
}

.comment.highlighted {
    border-right-color: #dc143c;
    background: #fff5f5;
}

.comment-header {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    align-items: center;
    margin-bottom: 10px;
}

.commenter-name {
    font-weight: bold;
    color: #1a1a2e;
    font-size: 16px;
}

.comment-time {
    color: #999;
    font-size: 14px;
}

.warning-badge {
    background: #ff6347;
    color: white;
    padding: 3px 10px;
    font-size: 12px;
    border-radius: 3px;
}

.comment-text {
    margin-bottom: 10px;
    font-size: 15px;
    line-height: 1.6;
}

.comment-actions {
    display: flex;
    gap: 15px;
}

.comment-actions button {
    background: none;
    border: 1px solid #ccc;
    padding: 5px 12px;
    cursor: pointer;
    font-size: 13px;
    transition: all 0.2s ease;
}

.comment-actions button:hover {
    background: #f0f0f0;
    border-color: #999;
}

.report-btn {
    color: #dc143c;
}

.load-more-comments {
    display: block;
    margin: 20px auto 0;
    background: #8b7355;
    color: white;
    border: none;
    padding: 12px 30px;
    font-size: 16px;
    cursor: pointer;
    transition: all 0.3s ease;
}

.load-more-comments:hover {
    background: #d4af37;
    color: #1a1a2e;
}

/* Newsletter Section */
.newsletter-section {
    background: linear-gradient(135deg, #1a1a2e 0%, #3a3226 100%);
    color: #f4e4c1;
    padding: 40px 20px;
    text-align: center;
}

.newsletter-section h2 {
    font-size: 32px;
    margin-bottom: 15px;
}

.newsletter-section p {
    font-size: 18px;
    margin-bottom: 25px;
}

.newsletter-form {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.newsletter-form input {
    padding: 15px;
    border: 2px solid #d4af37;
    font-family: 'Georgia', serif;
    font-size: 16px;
    background: #faf8f0;
}

.newsletter-form button {
    background: #d4af37;
    color: #1a1a2e;
    border: none;
    padding: 15px 30px;
    font-size: 18px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s ease;
}

.newsletter-form button:hover {
    background: #f4e4c1;
    transform: scale(1.05);
}

.newsletter-disclaimer {
    font-size: 12px;
    color: #999;
    margin-top: 15px;
    font-style: italic;
}

/* Poll Section */
.poll-section {
    background: white;
    padding: 30px 20px;
    margin: 30px 20px;
    border: 3px solid #8b7355;
    text-align: center;
}

.poll-section h2 {
    font-size: 32px;
    color: #1a1a2e;
    margin-bottom: 10px;
}

.poll-section h3 {
    font-size: 22px;
    color: #5a4a3a;
    margin-bottom: 25px;
}

.poll-options {
    max-width: 600px;
    margin: 0 auto 25px;
}

.poll-option {
    margin-bottom: 15px;
}

.poll-option input[type="radio"] {
    display: none;
}

.poll-option label {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 15px;
    border: 2px solid #ddd;
    cursor: pointer;
    position: relative;
    transition: all 0.3s ease;
}

.poll-option label:hover {
    background: #f9f7f0;
    border-color: #8b7355;
}

.poll-option input[type="radio"]:checked + label {
    background: #f4e4c1;
    border-color: #d4af37;
}

.poll-text {
    flex: 1;
    text-align: right;
    font-weight: bold;
}

.poll-bar {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    background: rgba(212, 175, 55, 0.3);
    z-index: -1;
}

.poll-percent {
    font-weight: bold;
    color: #8b0000;
}

.vote-btn {
    background: #8b0000;
    color: white;
    border: none;
    padding: 15px 40px;
    font-size: 18px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s ease;
}

.vote-btn:hover {
    background: #dc143c;
    transform: scale(1.05);
}

.poll-disclaimer {
    margin-top: 15px;
    font-size: 14px;
    color: #666;
    font-style: italic;
}

/* Footer */
.main-footer {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    color: #f4e4c1;
    padding: 40px 20px 20px;
    border-top: 5px double #d4af37;
}

.footer-decoration {
    text-align: center;
    font-size: 20px;
    letter-spacing: 20px;
    color: #d4af37;
    margin-bottom: 20px;
}

.footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
    margin-bottom: 30px;
}

.footer-section h3 {
    color: #d4af37;
    font-size: 20px;
    margin-bottom: 15px;
    border-bottom: 2px solid #d4af37;
    padding-bottom: 10px;
}

.footer-section p {
    line-height: 1.8;
    margin-bottom: 10px;
}

.footer-section ul {
    list-style: none;
}

.footer-section ul li {
    margin-bottom: 8px;
}

.footer-section a {
    color: #f4e4c1;
    text-decoration: none;
    transition: color 0.3s ease;
}

.footer-section a:hover {
    color: #d4af37;
}

.footer-bottom {
    text-align: center;
    padding-top: 20px;
    border-top: 1px solid #d4af37;
}

.footer-bottom p {
    margin: 10px 0;
}

.motto {
    font-size: 20px;
    font-weight: bold;
    color: #d4af37;
    letter-spacing: 2px;
}

#execution-counter {
    color: #dc143c;
    font-weight: bold;
    font-size: 18px;
}

/* Responsive Design */
@media (max-width: 768px) {
    .site-title {
        font-size: 36px;
    }
    
    .content-grid {
        grid-template-columns: 1fr;
        padding: 20px 10px;
    }
    
    .main-nav ul {
        flex-direction: column;
    }
    
    .main-nav li {
        min-width: 100%;
    }
    
    .main-nav a {
        border-left: none;
        border-bottom: 1px solid #5a4a3a;
    }
    
    article h2 {
        font-size: 24px;
    }
    
    article h3 {
        font-size: 18px;
    }
    
    .newsletter-form {
        flex-direction: column;
    }
}

/* Print Styles */
@media print {
    .breaking-banner,
    .main-nav,
    .comment-form,
    .newsletter-section,
    .engagement-bar,
    .read-more {
        display: none;
    }
    
    body {
        background: white;
    }
    
    .page-wrapper {
        box-shadow: none;
        border: none;
    }
}

/* Animations */
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.article-card,
.featured-article {
    animation: fadeIn 0.5s ease-out;
}

.article-card:nth-child(odd) {
    animation-delay: 0.1s;
}

.article-card:nth-child(even) {
    animation-delay: 0.2s;
}
